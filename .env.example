APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Set TRUSTED_PROXIES to the exact reverse-proxy IPs/CIDRs when deployed behind one.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
SOURCE_FILES_DISK=local
SOURCE_FILE_MAX_SIZE_KB=25600
QUEUE_CONNECTION=database

SEARCH_ENGINE=postgres
TYPESENSE_HOST=127.0.0.1
TYPESENSE_PORT=8108
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=
TYPESENSE_CONNECTION_TIMEOUT=2
TYPESENSE_SEARCH_TIMEOUT=2
TYPESENSE_SYNC_AFTER_IMPORT=false
REST_SOURCE_CONNECT_TIMEOUT=5
REST_SOURCE_TIMEOUT=30
REST_SOURCE_MAX_PAGES=100
REST_SOURCE_MAX_RECORDS=10000
REST_SOURCE_MAX_RESPONSE_BYTES=10485760
REST_SOURCE_USER_AGENT="AI-Search-Assistant/1.0"

OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_TIMEOUT=30
OPENAI_MAX_TOOL_ROUNDS=3
OPENAI_MAX_RESULTS=10
LIVE_READ_DEFAULT_RESULTS=5
LIVE_READ_EXPANDED_RESULTS=10
LIVE_READ_MAX_RESULTS=20
LIVE_READ_MAX_CANDIDATES=500
LIVE_READ_MAX_PAGES=10
LIVE_READ_TIMEOUT_SECONDS=15
LIVE_READ_MAX_RESPONSE_BYTES=5242880
AI_CONVERSATION_MAX_MESSAGES=20

WIDGET_BASE_URL=
# Public bot UUID to display on the welcome page in this environment.
WIDGET_DEMO_BOT_ID=
WIDGET_ALLOW_LOCALHOST=
WIDGET_MESSAGE_MAX_LENGTH=4000
WIDGET_HISTORY_LIMIT=20
WIDGET_RATE_LIMIT_PER_MINUTE=30

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
POSTMARK_API_URL=https://api.postmarkapp.com
POSTMARK_TIMEOUT=8
POSTMARK_CONNECT_TIMEOUT=3
POSTMARK_WEBHOOK_USERNAME=postmark

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TWILIO_API_URL=https://api.twilio.com
TWILIO_TIMEOUT=8
TWILIO_CONNECT_TIMEOUT=3

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=
BILLING_CURRENCY=usd
STRIPE_TIMEOUT=15
STRIPE_CONNECT_TIMEOUT=5
STRIPE_WEBHOOK_TOLERANCE=300
SPEECH_TO_TEXT_DRIVER=assemblyai
SPEECH_TO_TEXT_URL=http://speech-to-text:8000
SPEECH_TO_TEXT_TOKEN=
SPEECH_TO_TEXT_TIMEOUT=90
SPEECH_TO_TEXT_CONNECT_TIMEOUT=5
SPEECH_TO_TEXT_MAX_UPLOAD_KILOBYTES=10240
SPEECH_TO_TEXT_MAX_DURATION_SECONDS=60
SPEECH_TO_TEXT_RATE_LIMIT_PER_MINUTE=10
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_BASE_URL=https://api.assemblyai.com
ASSEMBLYAI_TIMEOUT=30
ASSEMBLYAI_CONNECT_TIMEOUT=5
ASSEMBLYAI_POLL_INTERVAL_MS=500
ASSEMBLYAI_MAX_POLL_SECONDS=30
